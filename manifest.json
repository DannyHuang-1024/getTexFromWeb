{
  "manifest_version": 3,
  "name": "getTexFormula",
  "version": "2.5.2",
  "description": "Capture and copy LaTeX formulas from rendered math on web pages.",
  "action": {
    "default_popup": "panel.html",
    "default_icon": { "16": "resources/icon_16.png", "32": "resources/icon_32.png" }
  },
  "icons": {
    "16": "resources/icon_16.png",
    "32": "resources/icon_32.png",
    "48": "resources/icon_48.png",
    "128": "resources/icon_128.png"
  },

  "permissions": ["storage", "clipboardWrite"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.html", "resources/panel.svg"],
      "matches": ["<all_urls>"]
    }
  ]
}
